NEXT_PUBLIC_SANITY_PROJECT_ID=1qxhnoe8
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Centre d'aide — projet Sanity séparé
NEXT_PUBLIC_SANITY_FAQ_PROJECT_ID=87k2mn7n
NEXT_PUBLIC_SANITY_FAQ_DATASET=production
NEXT_PUBLIC_HELP_SITE_URL=https://help.segnashare.com
SANITY_REVALIDATE_SECRET=change-me-to-a-long-random-string
# Google Analytics 4 (www.segnashare.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BMMCB64037
NEXT_PUBLIC_COOKIEBOT_CBID=3daff10a-7d1c-40b9-a577-c958419ad47a
# PostHog — même projet EU que segna-mobile (funnels website ↔ app)
# Settings → Project → Project API key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# En local, le cache Sanity/ISR est désactivé par défaut (rechargement immédiat après publication).
# SANITY_DEV_CACHE=true — réactiver le cache 1 h en dev pour reproduire la prod.
# SANITY_USE_LIVE_API=false — forcer le CDN Sanity en dev (déconseillé).
# Catalogue marketing (pièces base Segna) — uniquement côté serveur pour la RPC dédiée.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Clé anon / publishable — OBLIGATOIRE en prod Vercel (signup / login website)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
# JWT service_role (ancien dashboard) OU clé secrète API (dashboard récent, souvent sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=your-secret-api-key

# Chat pièce → n8n → Discord
# N8N_ITEM_CHAT_WEBHOOK_URL=https://segnashare.app.n8n.cloud/webhook/item-chat
# N8N_ITEM_CHAT_WEBHOOK_SECRET=
# Retour n8n → site : POST /api/internal/item-chat/reply
# SEGNA_INTERNAL_ITEM_CHAT_SECRET=
# Sync Discord → chat (token bot, lecture des fils)
# DISCORD_BOT_TOKEN=
# NEXT_PUBLIC_MARKETING_SITE_URL=https://www.segnashare.com
# NEXT_PUBLIC_SEGNA_APP_URL=https://app.segnashare.com

# Google Maps Embed (optionnel) + Places Autocomplete checkout
# Places API (New) doit être activée sur la clé pour l’autocomplete adresse.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Optionnel : clé dédiée Places (sinon fallback sur la clé Embed)
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
